generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  GUIDE
  ADMIN
}

enum ContentStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
  EXPIRED
}

enum MinyanType {
  ONE_TIME
  RECURRING
}

enum PrayerType {
  SHACHARIT
  MINCHA
  MAARIV
  MUSAF
  OTHER
}

enum LocationType {
  SYNAGOGUE
  CHABAD
  BOTH
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  phone         String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  minyanim      Minyan[]
  participants  MinyanParticipant[]
  locations     JewishLocation[]
  products      KosherProduct[]
  guideProfile  GuideProfile?
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Country {
  id     String @id @default(cuid())
  name   String
  code   String @unique
  cities City[]
  minyanim Minyan[]
  locations JewishLocation[]
  products KosherProduct[]
}

model City {
  id        String @id @default(cuid())
  name      String
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  minyanim Minyan[]
  locations JewishLocation[]
  products KosherProduct[]
  @@unique([countryId, name])
}

model Minyan {
  id              String @id @default(cuid())
  title           String
  prayerType      PrayerType
  type            MinyanType
  startDateTime   DateTime
  expiresAt       DateTime
  recurrenceRule  String?
  time            String?
  countryId       String?
  cityId          String?
  address         String?
  latitude        Float?
  longitude       Float?
  description     String?
  contactName     String?
  contactPhone    String?
  createdById     String
  status          ContentStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User @relation(fields: [createdById], references: [id])
  country         Country? @relation(fields: [countryId], references: [id])
  city            City? @relation(fields: [cityId], references: [id])
  participants    MinyanParticipant[]
  @@index([status, expiresAt])
}

model MinyanParticipant {
  id        String @id @default(cuid())
  minyanId  String
  userId    String
  createdAt DateTime @default(now())
  minyan    Minyan @relation(fields: [minyanId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([minyanId, userId])
}

model JewishLocation {
  id          String @id @default(cuid())
  name        String
  type        LocationType
  countryId   String?
  cityId      String?
  address     String?
  latitude    Float?
  longitude   Float?
  phone       String?
  email       String?
  website     String?
  description String?
  imageUrl    String?
  createdById String
  status      ContentStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User @relation(fields: [createdById], references: [id])
  country     Country? @relation(fields: [countryId], references: [id])
  city        City? @relation(fields: [cityId], references: [id])
}

model KosherProduct {
  id          String @id @default(cuid())
  name        String
  brand       String?
  category    String?
  countryId   String?
  cityId      String?
  description String?
  kosherInfo  String?
  imageUrl    String?
  createdById String
  status      ContentStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User @relation(fields: [createdById], references: [id])
  country     Country? @relation(fields: [countryId], references: [id])
  city        City? @relation(fields: [cityId], references: [id])
}

model GuideProfile {
  id             String @id @default(cuid())
  userId         String @unique
  displayName    String
  bio            String?
  phone          String?
  email          String?
  website        String?
  languages      String[]
  imageUrl       String?
  yearsExperience Int?
  status         ContentStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
